//@version=5
// ============================================================================
//  THE RECLAIM PLAYBOOK  —  confluence scorer  (Pine v5, overlay)
//  Built from your own trading record.
//
//  Four signals, read together, for a LONG or SHORT:
//    1) 8/21 EMA cross ............ trigger (▲ bull cross / ▼ bear cross)
//    2) Auto-anchored Volume Profile  bias .... price above POC = bullish,
//       (session or last-swing anchor)          below POC = bearish
//    3) VWAP position ............. above = long bias, below = short bias
//    4) Support / Resistance ...... auto pivots; entry AT the level
//  + volume spike + reward:risk complete a 6-point checklist (need 4/6).
//
//  STRICT GATE (⑥): a green "CALLS" label prints only when EMA + VWAP + Volume
//  Profile are ALL bullish (red "PUTS" when all bearish). Toggle each with a
//  checkbox. This is the pure 3-of-3 signal for your 2-min entries.
//
//  Also: 12–1pm ET shaded red and force-locked to NO-TRADE.
//  Use: Pine Editor → paste → Add to chart. Best on 1–5 min, ride-list names.
// ============================================================================
indicator("The Reclaim Playbook", "RECLAIM", overlay=true, max_lines_count=500, max_labels_count=100, max_boxes_count=500)

// ---------------------------------------------------------------- Inputs ----
gT = "① Triggers — EMA / VWAP"
emaFastLen = input.int(8,  "Fast EMA", minval=1, group=gT)
emaSlowLen = input.int(21, "Slow EMA", minval=1, group=gT)
useVWAP    = input.bool(true, "Use VWAP position as a signal", group=gT)

gV = "② Auto-anchored Volume Profile"
anchorMode = input.string("Session", "Anchor", options=["Session", "Last swing"], group=gV)
vpBins     = input.int(24, "Profile rows", minval=6, maxval=60, group=gV)
showVP     = input.bool(true, "Draw profile + POC", group=gV)

gS = "③ Support / Resistance"
pivLen   = input.int(10,  "Pivot lookback", minval=2, group=gS)
maxLvls  = input.int(6,   "Levels per side", minval=1, maxval=20, group=gS)
nearMult = input.float(0.5, "‘At a level’ distance (×ATR)", step=0.1, group=gS)

gC = "④ Confirmation / risk"
volLen  = input.int(20,  "Volume average length", minval=1, group=gC)
volMult = input.float(1.5, "Volume spike (× average)", step=0.1, group=gC)
rrMin   = input.float(2.0, "Minimum reward : risk", step=0.5, group=gC)
adxTrend= input.int(20,  "ADX ≥ this = TREND day", group=gC)

gX = "⑤ No-trade window"
useNoTrade = input.bool(true, "Block 12–1pm ET", group=gX)
ntSession  = input.session("1200-1300", "Window (HHMM-HHMM)", group=gX)
ntTZ       = input.string("America/New_York", "Timezone", group=gX)

gG = "⑥ Simple CALLS / PUTS  (strict 3-of-3, your 2-min gate)"
showCalls   = input.bool(true, "✔ CALLS signal — EMA + VWAP + Profile ALL bullish", group=gG)
showPuts    = input.bool(true, "✔ PUTS signal — EMA + VWAP + Profile ALL bearish", group=gG)
markEveryBar= input.bool(false, "Mark every aligned bar (off = only the first)", group=gG)
needCross   = input.bool(false, "Require a fresh EMA cross on the signal bar", group=gG)

// ------------------------------------------------------------ Core calcs ----
atr     = ta.atr(14)
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
volMA   = ta.sma(volume, volLen)
vwap    = ta.vwap
[diP_, diM_, adx] = ta.dmi(14, 14)

plot(emaFast, "Fast EMA", color=color.new(#4a90e2, 0), linewidth=2)
plot(emaSlow, "Slow EMA", color=color.new(#e0a53c, 25), linewidth=1)
plot(useVWAP ? vwap : na, "VWAP", color=color.new(#9085e9, 0), linewidth=2)

// 1) EMA cross ---------------------------------------------------------------
emaCrossUp = ta.crossover(emaFast, emaSlow)
emaCrossDn = ta.crossunder(emaFast, emaSlow)
emaBull    = emaFast > emaSlow
emaBear    = emaFast < emaSlow

// 3) VWAP position -----------------------------------------------------------
aboveVWAP = not useVWAP or close >= vwap
belowVWAP = not useVWAP or close <= vwap

// ---------------------------------------------- Pivot S/R levels (gold) -----
gold = #d9a520
ph = ta.pivothigh(pivLen, pivLen)
pl = ta.pivotlow(pivLen, pivLen)
var line[] resLines = array.new_line()
var line[] supLines = array.new_line()
if not na(ph)
    ln = line.new(bar_index - pivLen, ph, bar_index, ph, color=color.new(gold, 0), width=1, extend=extend.right)
    array.push(resLines, ln)
    if array.size(resLines) > maxLvls
        line.delete(array.shift(resLines))
if not na(pl)
    ln = line.new(bar_index - pivLen, pl, bar_index, pl, color=color.new(gold, 35), width=1, extend=extend.right)
    array.push(supLines, ln)
    if array.size(supLines) > maxLvls
        line.delete(array.shift(supLines))

f_below(arr) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            lv = line.get_y1(array.get(arr, i))
            if lv <= close and (na(best) or lv > best)
                best := lv
    best
f_above(arr) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            lv = line.get_y1(array.get(arr, i))
            if lv >= close and (na(best) or lv < best)
                best := lv
    best
support    = f_below(supLines)
resistance = f_above(resLines)
support    := na(support)    ? close - atr     : support
resistance := na(resistance) ? close + 2 * atr : resistance

// ------------------------------------ 2) Auto-anchored Volume Profile --------
var int anchorBar = 0
if anchorMode == "Session"
    if ta.change(dayofmonth) != 0
        anchorBar := bar_index
else
    if not na(ph) or not na(pl)
        anchorBar := bar_index - pivLen

var float poc  = na
var float vah  = na
var float val_ = na
var box[] vpBoxes = array.new_box()
var line  pocLn = na

if barstate.islast
    lenP = math.max(bar_index - anchorBar, 1)
    // range since anchor
    float hi = high
    float lo = low
    for i = 0 to lenP - 1
        hi := math.max(hi, high[i])
        lo := math.min(lo, low[i])
    rng = math.max(hi - lo, syminfo.mintick)
    bs  = rng / vpBins
    // bin the volume
    vol = array.new_float(vpBins, 0.0)
    for i = 0 to lenP - 1
        p   = (high[i] + low[i] + close[i]) / 3
        idx = math.max(0, math.min(vpBins - 1, int((p - lo) / bs)))
        array.set(vol, idx, array.get(vol, idx) + volume[i])
    // POC + total
    maxv = 0.0
    pocIdx = 0
    total = 0.0
    for b = 0 to vpBins - 1
        v = array.get(vol, b)
        total += v
        if v > maxv
            maxv := v
            pocIdx := b
    poc := lo + (pocIdx + 0.5) * bs
    // 70% value area (expand from POC)
    acc = maxv
    lo_i = pocIdx
    hi_i = pocIdx
    while acc < total * 0.7 and (lo_i > 0 or hi_i < vpBins - 1)
        dn = lo_i > 0 ? array.get(vol, lo_i - 1) : -1.0
        up = hi_i < vpBins - 1 ? array.get(vol, hi_i + 1) : -1.0
        if up >= dn
            hi_i += 1
            acc += math.max(up, 0)
        else
            lo_i -= 1
            acc += math.max(dn, 0)
    vah := lo + (hi_i + 1) * bs
    val_ := lo + lo_i * bs
    // draw
    if array.size(vpBoxes) > 0
        for i = 0 to array.size(vpBoxes) - 1
            box.delete(array.get(vpBoxes, i))
        array.clear(vpBoxes)
    if showVP
        rightX = bar_index + 2
        wBars  = 46
        for b = 0 to vpBins - 1
            v = array.get(vol, b)
            w = math.max(int(v / maxv * wBars), 1)
            bLo = lo + b * bs
            col = b == pocIdx ? color.new(#e0a53c, 20) : (bLo >= poc ? color.new(#26c85c, 74) : color.new(#e8635b, 74))
            array.push(vpBoxes, box.new(rightX, bLo + bs, rightX + w, bLo, border_width=0, bgcolor=col))
    if not na(pocLn)
        line.delete(pocLn)
    if showVP
        pocLn := line.new(anchorBar, poc, bar_index + 2, poc, color=color.new(#e0a53c, 0), width=1, style=line.style_dotted)

// Running POC — accumulated every bar since the anchor, so the Volume-Profile
// bias is valid on ALL bars (not just the last). This is what lets the strict
// CALLS/PUTS labels actually print across history and fire live.
pocStep = math.max(syminfo.mintick, nz(atr, syminfo.mintick * 20) * 0.05)
var float[] rpLvl = array.new_float()
var float[] rpVol = array.new_float()
if ta.change(anchorBar) != 0
    array.clear(rpLvl)
    array.clear(rpVol)
tpx = (high + low + close) / 3
lvlx = math.round(tpx / pocStep) * pocStep
ixx = array.indexof(rpLvl, lvlx)
if ixx == -1
    array.push(rpLvl, lvlx)
    array.push(rpVol, volume)
else
    array.set(rpVol, ixx, array.get(rpVol, ixx) + volume)
float pocLive = na
if array.size(rpVol) > 0
    mi = 0
    mv = array.get(rpVol, 0)
    if array.size(rpVol) > 1
        for i = 1 to array.size(rpVol) - 1
            v = array.get(rpVol, i)
            if v > mv
                mv := v
                mi := i
    pocLive := array.get(rpLvl, mi)

vpBull = not na(pocLive) and close > pocLive
vpBear = not na(pocLive) and close < pocLive

// --------------------------------------------------- Support/reclaim tests --
atSupport    = math.abs(close - support) <= atr * nearMult
atResistance = math.abs(close - resistance) <= atr * nearMult
reclaimLong  = low < support and close > support and close > open
rejectShort  = high > resistance and close < resistance and close < open

// ------------------------------------------------- 6-point score (each side)-
volSpike = volume > volMA * volMult
// long risk to nearest resistance
lStop = support - atr * 0.3
lRisk = math.max(close - lStop, syminfo.mintick)
lRR   = (resistance - close) / lRisk
// short risk to nearest support
sStop = resistance + atr * 0.3
sRisk = math.max(sStop - close, syminfo.mintick)
sRR   = (close - support) / sRisk

longChecks  = (emaBull?1:0)+(vpBull?1:0)+(aboveVWAP?1:0)+((atSupport or reclaimLong)?1:0)+(volSpike?1:0)+((lRR>=rrMin)?1:0)
shortChecks = (emaBear?1:0)+(vpBear?1:0)+(belowVWAP?1:0)+((atResistance or rejectShort)?1:0)+(volSpike?1:0)+((sRR>=rrMin)?1:0)

// ------------------------------------------------- Regime + no-trade --------
trendDay  = adx >= adxTrend
regimeTxt = trendDay ? "TREND" : "PIN"
sizeTxt   = trendDay ? (adx >= adxTrend + 8 ? "3" : "2") : "1 / sit"
inNT = useNoTrade and not na(time(timeframe.period, ntSession, ntTZ))
bgcolor(inNT ? color.new(#cf3b2f, 90) : na, title="No-trade 12–1pm ET")

// --------------------------------------------------------- Entry signals ----
longTrig  = (emaCrossUp or reclaimLong)
shortTrig = (emaCrossDn or rejectShort)
takeLong  = longTrig  and longChecks  >= 4 and aboveVWAP and not inNT
takeShort = shortTrig and shortChecks >= 4 and belowVWAP and not inNT

plotshape(takeLong,  "Long entry",  shape.triangleup,   location.belowbar, color=color.new(#26c85c, 0), size=size.small, text="LONG",  textcolor=color.new(#26c85c, 0))
plotshape(takeShort, "Short entry", shape.triangledown, location.abovebar, color=color.new(#e8635b, 0), size=size.small, text="SHORT", textcolor=color.new(#e8635b, 0))
plotchar(emaCrossUp and not takeLong,  "EMA cross up",   "△", location.belowbar, color=color.new(#26c85c, 45), size=size.tiny)
plotchar(emaCrossDn and not takeShort, "EMA cross down", "▽", location.abovebar, color=color.new(#e8635b, 45), size=size.tiny)
alertcondition(takeLong,  "Long confluence (≥4/6)",  "RECLAIM LONG on {{ticker}} — 4/6, EMA/VWAP/VP aligned")
alertcondition(takeShort, "Short confluence (≥4/6)", "RECLAIM SHORT on {{ticker}} — 4/6, EMA/VWAP/VP aligned")

// ------------------ Strict 3-of-3 CALLS / PUTS  (the pure confluence gate) ---
// Fires only when ALL THREE core signals agree: 8/21 EMA, VWAP, Volume Profile.
// This is the "everything is green → go for calls" trigger you asked for.
// Note: the Volume-Profile bias is evaluated on the live (developing) bar, so
// CALLS/PUTS labels and alerts print in real time on your entry chart. Add this
// indicator to the 2-min chart you enter on.
fullBull = emaBull and aboveVWAP and vpBull and not inNT and (not needCross or emaCrossUp)
fullBear = emaBear and belowVWAP and vpBear and not inNT and (not needCross or emaCrossDn)
callsSig = showCalls and fullBull and (markEveryBar or not fullBull[1])
putsSig  = showPuts  and fullBear and (markEveryBar or not fullBear[1])
plotshape(callsSig, "CALLS — 3/3 bullish", shape.labelup,   location.belowbar, color=color.new(#14c784, 0), textcolor=color.white, text="CALLS", size=size.normal)
plotshape(putsSig,  "PUTS — 3/3 bearish",  shape.labeldown, location.abovebar, color=color.new(#e8635b, 0), textcolor=color.white, text="PUTS",  size=size.normal)
alertcondition(callsSig, "CALLS — 3 of 3 bullish", "CALLS on {{ticker}} {{interval}} — 8>21 EMA, price>VWAP, above POC")
alertcondition(putsSig,  "PUTS — 3 of 3 bearish",  "PUTS on {{ticker}} {{interval}} — 8<21 EMA, price<VWAP, below POC")

// ----------------------------------------------------- Dashboard table ------
isLong  = longChecks >= shortChecks
dScore  = isLong ? longChecks : shortChecks
dTrig   = isLong ? longTrig : shortTrig
dRR     = isLong ? lRR : sRR
dGoodRR = dRR >= rrMin
panel = color.new(#15181d, 6)
muted = #9aa0a8
mk(b)  => b ? "✓" : "·"
mkc(b) => b ? color.new(#26c85c, 0) : color.new(muted, 35)

var table t = table.new(position.top_right, 2, 13, border_width=1, frame_color=color.new(#e0a53c, 40), frame_width=1)
f_row(r, k, v, vc) =>
    table.cell(t, 0, r, k, text_size=size.small, text_color=muted, text_halign=text.align_left,  bgcolor=panel)
    table.cell(t, 1, r, v, text_size=size.small, text_color=vc,    text_halign=text.align_right, bgcolor=panel)

if barstate.islast
    dirTxt = isLong ? "LONG" : "SHORT"
    dcol = isLong ? color.new(#26c85c, 0) : color.new(#e8635b, 0)
    table.cell(t, 0, 0, "RECLAIM PLAYBOOK", text_size=size.normal, text_color=#e0a53c, text_halign=text.align_left, bgcolor=panel)
    table.cell(t, 1, 0, dirTxt, text_size=size.normal, text_color=dcol, text_halign=text.align_right, bgcolor=panel)
    f_row(1, "1 · 8/21 EMA",   isLong ? (emaBull?"bull":"·") : (emaBear?"bear":"·"), mkc(isLong?emaBull:emaBear))
    f_row(2, "2 · Vol Profile", isLong ? (vpBull?"> POC":"·") : (vpBear?"< POC":"·"), mkc(isLong?vpBull:vpBear))
    f_row(3, "3 · VWAP",       isLong ? (aboveVWAP?"above":"·") : (belowVWAP?"below":"·"), mkc(isLong?aboveVWAP:belowVWAP))
    f_row(4, "4 · At S/R",     mk(isLong?(atSupport or reclaimLong):(atResistance or rejectShort)), mkc(isLong?(atSupport or reclaimLong):(atResistance or rejectShort)))
    f_row(5, "5 · Volume",     mk(volSpike), mkc(volSpike))
    f_row(6, "6 · R:R ≥ " + str.tostring(rrMin, "#.#"), mk(dGoodRR), mkc(dGoodRR))
    f_row(7, "SCORE", str.tostring(dScore) + " / 6", dScore >= 4 ? color.new(#26c85c, 0) : color.new(#e8635b, 0))
    verdict = inNT ? "NO-TRADE · 12–1pm" : (((isLong?takeLong:takeShort)) ? "TAKE " + dirTxt : (dTrig ? "close — wait 4/6" : "WAIT for trigger"))
    vcol    = inNT ? color.new(#e8635b, 0) : (((isLong?takeLong:takeShort)) ? dcol : color.new(muted, 0))
    f_row(8, "VERDICT", verdict, vcol)
    f_row(9,  "POC", na(pocLive) ? "—" : str.tostring(pocLive, format.mintick), color.new(#e0a53c, 0))
    f_row(10, "VWAP", str.tostring(vwap, format.mintick), color.new(#9085e9, 0))
    f_row(11, "Regime", regimeTxt + " · ADX " + str.tostring(math.round(adx)), trendDay ? color.new(#26c85c, 0) : color.new(#e0a53c, 0))
    f_row(12, "Max size / R:R", sizeTxt + "  ·  " + str.tostring(dRR, "#.0") + ":1", color.white)
