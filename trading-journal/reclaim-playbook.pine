//@version=5
// ============================================================================
//  THE RECLAIM PLAYBOOK  —  live on-chart scorer
//  Built from your own trading record. Overlay indicator, Pine v5.
//
//  What it does:
//   • Auto-draws S/R levels (gold) from swing pivots
//   • Flags the flush→reclaim long entry with a ▲ marker + alert
//   • Scores your 6-point checklist live in a corner table (need 4/6)
//   • Reads regime (TREND vs PIN) off ADX and suggests max size
//   • Shades 12–1pm ET red and forces NO-TRADE in that window
//
//  How to use: TradingView → Pine Editor → paste → Add to chart.
//  Best on a 1–5 min chart of a name on your ride list (SPCX/META/AAPL/TSLA).
// ============================================================================
indicator("The Reclaim Playbook", "RECLAIM", overlay=true, max_lines_count=500, max_labels_count=100)

// ---------------------------------------------------------------- Inputs ----
gS = "① Setup / Levels"
pivLen   = input.int(10,  "Pivot lookback (S/R sensitivity)", minval=2, group=gS)
maxLvls  = input.int(6,   "Max S/R levels per side",          minval=1, maxval=20, group=gS)
nearMult = input.float(0.5, "‘At a level’ distance (×ATR)",   step=0.1, group=gS)

gT = "② Triggers"
emaFastLen = input.int(9,    "Fast MA (trigger)", minval=1, group=gT)
emaSlowLen = input.int(21,   "Slow MA (trend)",   minval=1, group=gT)
volLen     = input.int(20,   "Volume average length", minval=1, group=gT)
volMult    = input.float(1.5,"Volume spike (× average)", step=0.1, group=gT)
runwayMult = input.float(1.5,"Clear runway to target (×ATR)", step=0.1, group=gT)
rrMin      = input.float(2.0,"Minimum reward : risk", step=0.5, group=gT)

gR = "③ Regime"
adxTrend = input.int(20, "ADX ≥ this = TREND day", group=gR)

gX = "④ No-trade window (your worst hour)"
useNoTrade = input.bool(true,        "Block 12–1pm ET", group=gX)
ntSession  = input.session("1200-1300", "Window (HHMM-HHMM)", group=gX)
ntTZ       = input.string("America/New_York", "Timezone", group=gX)

gU = "⑤ Display"
showLevels = input.bool(true, "Show S/R levels", group=gU)
showTgt    = input.bool(true, "Draw stop / target on entry", group=gU)

// ------------------------------------------------------------ Core calcs ----
atr     = ta.atr(14)
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
volMA   = ta.sma(volume, volLen)
[diP, diM, adx] = ta.dmi(14, 14)

plot(emaFast, "Fast MA", color=color.new(#4a90e2, 0), linewidth=2)
plot(emaSlow, "Slow MA", color=color.new(#e0a53c, 30), linewidth=1)

// --------------------------------------------------- Pivot S/R levels -------
gold = #d9a520
ph = ta.pivothigh(pivLen, pivLen)
pl = ta.pivotlow(pivLen, pivLen)
var line[] resLines = array.new_line()
var line[] supLines = array.new_line()

if showLevels and not na(ph)
    ln = line.new(bar_index - pivLen, ph, bar_index, ph, color=color.new(gold, 0), width=1, extend=extend.right)
    array.push(resLines, ln)
    if array.size(resLines) > maxLvls
        line.delete(array.shift(resLines))
if showLevels and not na(pl)
    ln = line.new(bar_index - pivLen, pl, bar_index, pl, color=color.new(gold, 35), width=1, extend=extend.right)
    array.push(supLines, ln)
    if array.size(supLines) > maxLvls
        line.delete(array.shift(supLines))

// nearest active level below / above current price
f_below(arr) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            lv = line.get_y1(array.get(arr, i))
            if lv <= close and (na(best) or lv > best)
                best := lv
    best
f_above(arr) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            lv = line.get_y1(array.get(arr, i))
            if lv >= close and (na(best) or lv < best)
                best := lv
    best

support    = f_below(supLines)
resistance = f_above(resLines)
support    := na(support)    ? close - atr     : support
resistance := na(resistance) ? close + 2 * atr : resistance

// -------------------------------------------------- The 6-point checklist ---
atLevel     = math.abs(close - support) <= atr * nearMult            // 1 at a marked level
reclaim     = low < support and close > support and close > open      // 2 flush → reclaim (long)
maReclaim   = close > emaFast and emaFast >= emaFast[1]               // 3 fast MA reclaimed & curling
volSpike    = volume > volMA * volMult                               // 4 volume behind the move
clearRunway = (resistance - close) >= atr * runwayMult               // 5 clear runway to target
stop        = support - atr * 0.3
risk        = math.max(close - stop, syminfo.mintick)
reward      = resistance - close
rr          = reward / risk
goodRR      = rr >= rrMin                                            // 6 reward : risk

score = (atLevel?1:0)+(reclaim?1:0)+(maReclaim?1:0)+(volSpike?1:0)+(clearRunway?1:0)+(goodRR?1:0)

// ----------------------------------------------------------- Regime ---------
trendDay  = adx >= adxTrend
regimeTxt = trendDay ? "TREND" : "PIN"
sizeTxt   = trendDay ? (adx >= adxTrend + 8 ? "3" : "2") : "1 / sit"

// ------------------------------------------------- No-trade window ----------
inNT = useNoTrade and not na(time(timeframe.period, ntSession, ntTZ))
bgcolor(inNT ? color.new(#cf3b2f, 90) : na, title="No-trade 12–1pm ET")

// --------------------------------------------------------- Entry signal -----
takeLong = reclaim and score >= 4 and not inNT
plotshape(takeLong, "Reclaim entry", shape.triangleup, location.belowbar, color=color.new(#0f9d58, 0), size=size.small, text="RECLAIM", textcolor=color.new(#0f9d58, 0))
alertcondition(takeLong, "Reclaim entry (≥4/6)", "RECLAIM setup on {{ticker}} — checklist ≥4/6 at a level")

// stop / target sketch on the signal bar
var line[] plan = array.new_line()
if showTgt and takeLong
    ls = line.new(bar_index, stop,       bar_index + 8, stop,       color=color.new(#cf3b2f, 0), width=1, style=line.style_dashed)
    lt = line.new(bar_index, resistance, bar_index + 8, resistance, color=color.new(#0f9d58, 0), width=1, style=line.style_dashed)
    label.new(bar_index, resistance, "T · " + str.tostring(rr, "#.0") + "R", style=label.style_label_down, color=color.new(#0f9d58, 20), textcolor=color.white, size=size.tiny)
    array.push(plan, ls)
    array.push(plan, lt)
    if array.size(plan) > 20
        line.delete(array.shift(plan))
        line.delete(array.shift(plan))

// ----------------------------------------------------- Dashboard table ------
panel = color.new(#15181d, 6)
muted = #9aa0a8
mk(b)  => b ? "✓" : "·"
mkc(b) => b ? color.new(#26c85c, 0) : color.new(muted, 35)

var table t = table.new(position.top_right, 2, 12, border_width=1, frame_color=color.new(#e0a53c, 40), frame_width=1)
f_row(r, k, v, vc) =>
    table.cell(t, 0, r, k, text_size=size.small, text_color=muted, text_halign=text.align_left,  bgcolor=panel)
    table.cell(t, 1, r, v, text_size=size.small, text_color=vc,    text_halign=text.align_right, bgcolor=panel)

if barstate.islast
    table.cell(t, 0, 0, "THE RECLAIM PLAYBOOK", text_size=size.normal, text_color=#e0a53c, text_halign=text.align_left, bgcolor=panel)
    table.cell(t, 1, 0, mk(true), text_color=panel, bgcolor=panel)
    f_row(1, "1 · At a level",       mk(atLevel),     mkc(atLevel))
    f_row(2, "2 · Flush → reclaim",  mk(reclaim),     mkc(reclaim))
    f_row(3, "3 · Fast MA reclaim",  mk(maReclaim),   mkc(maReclaim))
    f_row(4, "4 · Volume spike",     mk(volSpike),    mkc(volSpike))
    f_row(5, "5 · Clear runway",     mk(clearRunway), mkc(clearRunway))
    f_row(6, "6 · R:R ≥ " + str.tostring(rrMin, "#.#"), mk(goodRR), mkc(goodRR))
    f_row(7, "SCORE", str.tostring(score) + " / 6", score >= 4 ? color.new(#26c85c, 0) : color.new(#e8635b, 0))
    verdict = inNT ? "NO-TRADE · 12–1pm" : (takeLong ? "TAKE IT" : (reclaim ? "CLOSE — wait 4/6" : "WAIT for reclaim"))
    vcol    = inNT ? color.new(#e8635b, 0) : (takeLong ? color.new(#26c85c, 0) : color.new(muted, 0))
    f_row(8, "VERDICT", verdict, vcol)
    f_row(9,  "Regime", regimeTxt + " · ADX " + str.tostring(math.round(adx)), trendDay ? color.new(#26c85c, 0) : color.new(#e0a53c, 0))
    f_row(10, "Max size", sizeTxt, color.white)
    f_row(11, "R:R now", str.tostring(rr, "#.0") + " : 1", goodRR ? color.new(#26c85c, 0) : color.new(muted, 0))
