# Copy to .env and adjust for your environment.
# All variables are prefixed with SERVICEFLOW_

# Database — SQLite (default) or PostgreSQL
# SERVICEFLOW_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/serviceflow
SERVICEFLOW_DATABASE_URL=sqlite:///./serviceflow.db

# Security — CHANGE THIS in production (use a long random string)
SERVICEFLOW_SECRET_KEY=change-me-to-a-long-random-secret
SERVICEFLOW_ACCESS_TOKEN_TTL_MIN=720

# CORS — comma-separated allowed origins, or * for dev
SERVICEFLOW_CORS_ORIGINS=*

SERVICEFLOW_ENVIRONMENT=development
