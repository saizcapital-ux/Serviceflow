# Copy to .env and adjust for your environment.
# All variables are prefixed with SERVICEFLOW_

# Database — SQLite (default) or PostgreSQL
# SERVICEFLOW_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/serviceflow
SERVICEFLOW_DATABASE_URL=sqlite:///./serviceflow.db

# Security — CHANGE THIS in production (use a long random string)
SERVICEFLOW_SECRET_KEY=change-me-to-a-long-random-secret
SERVICEFLOW_ACCESS_TOKEN_TTL_MIN=720

# Public URL of the frontend (used to build QR asset-tag deep links)
SERVICEFLOW_APP_BASE_URL=http://localhost:5173

# CORS — comma-separated allowed origins, or * for dev
SERVICEFLOW_CORS_ORIGINS=*

# File storage — "local" (default) or "s3".
SERVICEFLOW_STORAGE_BACKEND=local
SERVICEFLOW_STORAGE_DIR=./uploads
# For S3 (also `pip install boto3` and use IAM/instance creds):
# SERVICEFLOW_STORAGE_BACKEND=s3
# SERVICEFLOW_S3_BUCKET=my-serviceflow-bucket
# SERVICEFLOW_S3_REGION=us-east-1

# Notifications — if SMTP host is blank, emails are logged (console backend)
# but still recorded, so the feature works out of the box in dev.
SERVICEFLOW_NOTIFICATIONS_ENABLED=true
# SERVICEFLOW_SMTP_HOST=smtp.sendgrid.net
# SERVICEFLOW_SMTP_PORT=587
# SERVICEFLOW_SMTP_USER=apikey
# SERVICEFLOW_SMTP_PASSWORD=your-smtp-password
SERVICEFLOW_EMAIL_FROM=no-reply@serviceflow.app

# Stripe subscription billing — leave blank for mock mode (checkout activates
# the plan instantly). Set the secret key + `pip install stripe` for real checkout.
# SERVICEFLOW_STRIPE_SECRET_KEY=sk_test_xxx
# SERVICEFLOW_STRIPE_WEBHOOK_SECRET=whsec_xxx
# SERVICEFLOW_BILLING_SUCCESS_URL=http://localhost:5173/app/#/billing?checkout=success
# SERVICEFLOW_BILLING_CANCEL_URL=http://localhost:5173/app/#/billing?checkout=cancel

SERVICEFLOW_ENVIRONMENT=development
